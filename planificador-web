<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

<title>PLANIFICADOR WEB</title>

https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css

https://cdn.jsdelivr.net/npm/xlsx/dist/xlsx.full.min.jsscript>

<style>

body{
    background:#f5f7fb;
    padding:20px;
}

.card-box{
    background:white;
    border-radius:12px;
    padding:15px;
    box-shadow:0 2px 8px rgba(0,0,0,.10);
    margin-bottom:10px;
}

h1{
    font-size:24px;
    font-weight:bold;
}

.cat1{background:#006400;color:white;}
.cat2{background:#28a745;color:white;}
.cat3{background:#0d6efd;color:white;}
.cat4{background:#fd7e14;color:white;}
.cat5{background:#ffd966;color:black;}
.cat6{background:#7030a0;color:white;}
.cat7{background:#ff6666;color:white;}
.cat8{background:#c00000;color:white;}

#categoria{
    border-radius:8px;
    padding:10px;
    text-align:center;
    font-weight:bold;
    font-size:18px;
}

</style>
</head>

<body>

<div class="container-fluid">

<h1>PLANIFICADOR WEB</h1>

<div class="card-box">

<input
type="file"
id="arquivo"
accept=".xlsx,.xls"
class="form-control">

</div>

<div class="row">

<div class="col-md-4">
<select id="clienteSelect" class="form-select">
<option value="">Buscar Cliente</option>
</select>
</div>

<div class="col-md-4">
<select id="executivoSelect" class="form-select">
<option value="">Buscar Executivo</option>
</select>
</div>

<div class="col-md-4">
<input
id="cnpjBusca"
class="form-control"
placeholder="Buscar CNPJ">
</div>

</div>

<br>

<div class="row">

<div class="col-md-3">
<div class="card-box">
<b>Cliente</b>
<div id="cliente"></div>
</div>
</div>

<div class="col-md-3">
<div class="card-box">
<b>CNPJ</b>
<div id="cnpj"></div>
</div>
</div>

<div class="col-md-3">
<div class="card-box">
<b>Executivo</b>
<div id="executivo"></div>
</div>
</div>

<div class="col-md-3">
<div id="categoria">
Categoria
</div>
</div>

</div>

<br>

<div class="row">

<div class="col-md-3">
<div class="card-box">
<b>Objetivo Legrand</b>
<div id="objLegrand"></div>
</div>
</div>

<div class="col-md-3">
<div class="card-box">
<b>Fat. Legrand</b>
<div id="fatLegrand"></div>
</div>
</div>

<div class="col-md-3">
<div class="card-box">
<b>Objetivo OTC</b>
<div id="objOTC"></div>
</div>
</div>

<div class="col-md-3">
<div class="card-box">
<b>Fat. OTC</b>
<div id="fatOTC"></div>
</div>
</div>

</div>

</div>

<script>

let dados=[];

document
.getElementById("arquivo")
.addEventListener("change",carregarArquivo);

function carregarArquivo(e){

const arquivo=e.target.files[0];

const reader=new FileReader();

reader.onload=function(evt){

const wb=XLSX.read(
evt.target.result,
{type:"binary"}
);

const ws=wb.Sheets["PLANIFICADOR"];

dados=XLSX.utils.sheet_to_json(ws);

popularFiltros();

};

reader.readAsBinaryString(arquivo);

}

function popularFiltros(){

const clientes=[
...new Set(
dados.map(x=>x["RAZÃO SOCIAL"])
.filter(Boolean)
)
].sort();

const executivos=[
...new Set(
dados.map(x=>x["ET"])
.filter(Boolean)
)
].sort();

const clienteSelect=
document.getElementById("clienteSelect");

clienteSelect.innerHTML=
'<option value="">Buscar Cliente</option>';

clientes.forEach(c=>{

let op=document.createElement("option");

op.value=c;
op.text=c;

clienteSelect.appendChild(op);

});

const executivoSelect=
document.getElementById("executivoSelect");

executivoSelect.innerHTML=
'<option value="">Buscar Executivo</option>';

executivos.forEach(c=>{

let op=document.createElement("option");

op.value=c;
op.text=c;

executivoSelect.appendChild(op);

});

}

document
.getElementById("clienteSelect")
.addEventListener("change",function(){

const registro=
dados.find(
r=>r["RAZÃO SOCIAL"]===this.value
);

if(registro){
mostrar(registro);
}

});

document
.getElementById("cnpjBusca")
.addEventListener("keyup",function(){

const registro=
dados.find(
r=>String(r["CNPJ"])===this.value
);

if(registro){
mostrar(registro);
}

});

function mostrar(r){

document.getElementById("cliente")
.innerText=r["RAZÃO SOCIAL"]||"";

document.getElementById("cnpj")
.innerText=r["CNPJ"]||"";

document.getElementById("executivo")
.innerText=r["ET"]||"";

document.getElementById("objLegrand")
.innerText=r["OBJETIVO LEGRAND"]||0;

document.getElementById("fatLegrand")
.innerText=r["FAT. LEGRAND"]||0;

document.getElementById("objOTC")
.innerText=r["OBJETIVO OTC"]||0;

document.getElementById("fatOTC")
.innerText=r["FAT. OTC"]||0;

const categoria=
String(r["CAT"]||"");

const box=
document.getElementById("categoria");

box.className="";

switch(categoria){

case "CAT_1":
box.classList.add("cat1");
break;

case "CAT_2":
box.classList.add("cat2");
break;

case "CAT_3":
box.classList.add("cat3");
break;

case "CAT_4":
box.classList.add("cat4");
break;

case "CAT_5":
box.classList.add("cat5");
break;

case "CAT_6":
box.classList.add("cat6");
break;

case "CAT_7":
box.classList.add("cat7");
break;

case "CAT_8":
box.classList.add("cat8");
break;

}

box.innerText=categoria;

}

</script>

</body>
</html>
